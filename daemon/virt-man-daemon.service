[Unit]
Description=virt-man-daemon (QEMU HTTPS control daemon)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/virt-man-daemon
Restart=on-failure
RestartSec=3
# Runs as root: it creates taps and bridges, programs nftables and starts
# dnsmasq. The token and TLS key live under /etc/virt-man-daemon.

[Install]
WantedBy=multi-user.target
