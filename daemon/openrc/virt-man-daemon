#!/sbin/openrc-run
# virt-man-daemon on OpenRC (Alpine). The systemd unit is daemon/virt-man-daemon.service.
description="virt-man daemon (QEMU HTTPS control API)"
command="/usr/local/bin/virt-man-daemon"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"

depend() {
	# The daemon creates the network bridges and taps before any guest needs
	# them.
	need net
	after firewall
}
