# PAM service for the virt-man daemon shell.
#
# Every shell session re-authenticates the host account the shell will run as.
# This is the ordinary local-login check: verify the password, then confirm the
# account is not expired or otherwise unavailable. No session is opened, so
# pam_systemd and the like are deliberately absent -- the daemon starts the
# process itself, as the authenticated user.
auth     required  pam_unix.so
account  required  pam_unix.so
